# Firebase Configuration (Already connected automatically via firebase-applet-config.json - NO KEYS REQUIRED)

# Cloudinary Configuration (Image Uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# KoraPay Configuration
VITE_KORAPAY_PUBLIC_KEY=
KORAPAY_SECRET_KEY=

# Paystack Configuration
VITE_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
VITE_BACKEND_URL=

# Cloudflare R2 Configuration (Media Storage)
VITE_R2_ACCOUNT_ID=
VITE_R2_ACCESS_KEY_ID=
VITE_R2_SECRET_ACCESS_KEY=
VITE_R2_BUCKET_NAME=
VITE_R2_PUBLIC_URL=

# SMTP Configuration (External Provider like Resend/Postmark/Brevo)
# These are used in the backend email service
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=noreply@privyconnect.app

{
  "entities": {
    "profile": {
      "title": "Profile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "display_name": { "type": "string" },
        "photo_url": { "type": "string" },
        "bio": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "is_verified": { "type": "boolean" },
        "is_subscribed": { "type": "boolean" },
        "subscription_status": { "type": "string" },
        "profile_mode": { "type": "string" },
        "is_public": { "type": "boolean" },
        "hide_online_status": { "type": "boolean" },
        "is_online": { "type": "boolean" },
        "balance": { "type": "number" },
        "gender": { "type": "string" },
        "looking_for": { "type": "string" },
        "location_privacy": { "type": "string" },
        "messaging_privacy": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "username"]
    },
    "transaction": {
      "title": "Transaction",
      "description": "Financial transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "profile_id": { "type": "string" },
        "sender_id": { "type": "string" },
        "receiver_id": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string" },
        "status": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["profile_id", "amount", "type"]
    },
    "chat": {
      "title": "Chat",
      "description": "Chat room",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "last_message": { "type": "string" },
        "last_timestamp": { "type": "string", "format": "date-time" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "participants"]
    },
    "message": {
      "title": "Message",
      "description": "Chat message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "chat_id": { "type": "string" },
        "sender_id": { "type": "string" },
        "content": { "type": "string" },
        "message_type": { "type": "string" },
        "status": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["chat_id", "sender_id"]
    },
    "blocked_user": {
      "title": "Blocked User",
      "description": "Blocked user relationship",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "blocked_user_id": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["user_id", "blocked_user_id"]
    },
    "saved_profile": {
      "title": "Saved Profile",
      "description": "Saved profile relationship",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "saved_profile_id": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["user_id", "saved_profile_id"]
    },
    "report": {
      "title": "Report",
      "description": "User report",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "reporter_id": { "type": "string" },
        "reported_id": { "type": "string" },
        "reason": { "type": "string" },
        "status": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["reported_id", "reason"]
    },
    "system_setting": {
      "title": "System Setting",
      "description": "Global system setting",
      "type": "object",
      "properties": {
        "key": { "type": "string" },
        "value": { "type": "object" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["key", "value"]
    },
    "moderation_keyword": {
      "title": "Moderation Keyword",
      "description": "Keyword for moderation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "keyword": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["keyword"]
    },
    "notification": {
      "title": "Notification",
      "description": "User notification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "link": { "type": "string" },
        "is_read": { "type": "boolean" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["user_id", "type", "title", "message"]
    },
    "login_activity": {
      "title": "Login Activity",
      "description": "User login record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_id": { "type": "string" },
        "device": { "type": "string" },
        "location": { "type": "string" },
        "ip": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["user_id"]
    },
    "wallet": {
      "title": "Wallet",
      "description": "User wallet",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "profile_id": { "type": "string" },
        "balance": { "type": "number" },
        "currency": { "type": "string" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["profile_id", "balance"]
    }
  },
  "firestore": {
    "/profiles/{profileId}": {
      "schema": "profile",
      "description": "Collection of user profiles"
    },
    "/transactions/{transactionId}": {
      "schema": "transaction",
      "description": "Collection of transactions"
    },
    "/chats/{chatId}": {
      "schema": "chat",
      "description": "Collection of chats"
    },
    "/messages/{messageId}": {
      "schema": "message",
      "description": "Collection of messages"
    },
    "/blocked_users/{blockedUserId}": {
      "schema": "blocked_user",
      "description": "Collection of blocked users"
    },
    "/saved_profiles/{savedProfileId}": {
      "schema": "saved_profile",
      "description": "Collection of saved profiles"
    },
    "/reports/{reportId}": {
      "schema": "report",
      "description": "Collection of reports"
    },
    "/system_settings/{settingId}": {
      "schema": "system_setting",
      "description": "Collection of system settings"
    },
    "/moderation_keywords/{keywordId}": {
      "schema": "moderation_keyword",
      "description": "Collection of moderation keywords"
    },
    "/notifications/{notificationId}": {
      "schema": "notification",
      "description": "Collection of notifications"
    },
    "/login_activity/{activityId}": {
      "schema": "login_activity",
      "description": "Collection of login activities"
    },
    "/wallet/{walletId}": {
      "schema": "wallet",
      "description": "Collection of wallets"
    }
  }
}

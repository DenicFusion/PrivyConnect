{
  "rewrites": [
    { "source": "/api/verify-payment", "destination": "/api/verify-payment" },
    { "source": "/api/payment-success", "destination": "/api/payment-success" },
    { "source": "/api/webhook/paystack", "destination": "/api/webhook-paystack" },
